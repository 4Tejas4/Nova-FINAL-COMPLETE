<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nova_bg">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/settingsEntry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="4dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_gear"
                android:contentDescription="Settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings"
                android:textColor="@color/nova_text_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/chatButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_top_button"
            android:src="@drawable/ic_chat"
            android:contentDescription="Chat"
            android:tint="@color/nova_text" />
    </LinearLayout>

    <!-- Greeting bubble -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="@drawable/bg_greeting">

        <com.nova.ai.NovaOrbView
            android:id="@+id/greetingOrb"
            android:layout_width="34dp"
            android:layout_height="34dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Hello! I'm Nova, your AI assistant. How can I help you today?"
            android:textColor="@color/nova_text"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Center orb -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.nova.ai.NovaOrbView
            android:id="@+id/orb"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Status line -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.nova.ai.NovaEqView
            android:id="@+id/eq"
            android:layout_width="22dp"
            android:layout_height="18dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Ready"
            android:textColor="@color/nova_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/actionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center"
        android:text="Say “Hey Nova” to begin"
        android:textColor="@color/nova_text_dim"
        android:textSize="13sp" />

    <!-- Mic button -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="26dp">

        <View
            android:id="@+id/micGlow"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_glow" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_button"
            android:src="@drawable/ic_mic"
            android:contentDescription="Start or stop Nova"
            android:tint="@color/nova_text"
            android:scaleType="center" />
    </FrameLayout>
</LinearLayout>
