<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60%"
                android:startColor="#FFF6E8" android:centerColor="#FF9330" android:endColor="#B34A10" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#66FFC97A" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
